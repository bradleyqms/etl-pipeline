# QMS ETL Pipeline — Environment Variables
# Copy to .env and fill in values

# Microsoft Graph API (App Registration)
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-client-id
GRAPH_CLIENT_SECRET=your-client-secret

# Mailbox to read SAP dispatch emails from
PA_MAILBOX_ADDRESS=you@yourdomain.com

# Azure Data Lake (Blob Storage)
DATALAKE_ACCOUNT_NAME=your-storage-account-name
DATALAKE_ACCOUNT_KEY=your-storage-account-key
# Alternative: DATALAKE_CONNECTION_STRING=

SHAREPOINT_SITE_URL=https://yourtenant.sharepoint.com/sites/yoursite
SHAREPOINT_CLIENT_ID=your-sharepoint-client-id
SHAREPOINT_CLIENT_SECRET=your-sharepoint-client-secret

