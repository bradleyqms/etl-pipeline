# QMS ETL Pipeline — Environment Variables
# Copy to .env and fill in values

# Microsoft Graph API (App Registration)
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-client-id
GRAPH_CLIENT_SECRET=your-client-secret

# Mailbox to read SAP dispatch emails from
PA_MAILBOX_ADDRESS=you@yourdomain.com

# Azure Data Lake (Blob Storage)
DATALAKE_ACCOUNT_NAME=your-storage-account-name
DATALAKE_ACCOUNT_KEY=your-storage-account-key
# Alternative: DATALAKE_CONNECTION_STRING=

# Alerting
ALERT_ENABLED=true
ALERT_EMAIL_TO=ops@example.com
ENVIRONMENT=prod

# SharePoint budget ingestion (uses same Graph app credentials above)
SHAREPOINT_SITE_HOSTNAME=yourtenant.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/yoursite
SHAREPOINT_DOCUMENT_LIBRARY=Documents
SHAREPOINT_BUDGET_FOLDER=Shared Documents/Budgets/US
SHAREPOINT_BUDGET_FILENAME_PATTERN=*budget*.xlsx

# Governed sidecar federated SQL mapping (managed identity)
SIDECAR_SQL_SERVER=your-sql-server.database.windows.net
SIDECAR_SQL_DATABASE=dnr-mapping-db
SIDECAR_SQL_SCHEMA=dbo
SIDECAR_SQL_TABLE=entity_mappings
SIDECAR_SQL_ENTITY_NAME=GmbH
# Optional for user-assigned managed identity; leave blank for system-assigned
SIDECAR_SQL_MANAGED_IDENTITY_CLIENT_ID=

