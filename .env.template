# QMS ETL Pipeline — Environment Variables
# Copy to .env and fill in values

# Microsoft Graph API (App Registration)
GRAPH_TENANT_ID=your-tenant-id-here
GRAPH_CLIENT_ID=your-client-id-here
GRAPH_CLIENT_SECRET=your-client-secret-here

# Mailbox to read SAP dispatch emails from
PA_MAILBOX_ADDRESS=your-mailbox@example.com

# Azure Data Lake (Blob Storage)
DATALAKE_ACCOUNT_NAME=your-storage-account-name
DATALAKE_ACCOUNT_KEY=your-storage-account-key-here
# Alternative: DATALAKE_CONNECTION_STRING=your-connection-string-here

